    "rdp",
    "settlement-verified",
    "economic-execution-authorization"
  ],
  "author": {
    "name": "Aiyoplane, Inc.",
    "email": "rashon@aiyoplane.com",
    "url": "https://aiyoplane.com"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    }
  },
  "bin": {
    "aiyo-verify": "src/cli.js",
    "verify": "src/cli.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
